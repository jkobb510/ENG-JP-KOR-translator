<!DOCTYPE html>
<html>

<head>
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="styles.css">
</head>

<body>
  <div class="banner">
    <h2><%= heading %></h2>
  </div>

  <form id="translateForm">
    <textarea name="text" rows="5" placeholder="Enter text"></textarea>
    <div class="form-row">
      <div class="custom-select" id="inputSelect" data-value="en" aria-haspopup="listbox">
        <button type="button" class="custom-select-toggle" aria-expanded="false">English</button>
        <ul class="custom-select-menu" role="listbox" tabindex="-1">
          <li role="option" data-value="en" aria-selected="true">English</li>
          <li role="option" data-value="ja">Japanese</li>
          <li role="option" data-value="ko">Korean</li>
        </ul>
      </div>
      <button type="button" id="swapBtn" class="swap-btn" aria-label="Swap languages">⇄</button>

      <div class="custom-select" id="targetSelect" data-value="ja" aria-haspopup="listbox">
        <button type="button" class="custom-select-toggle" aria-expanded="false">Japanese</button>
        <ul class="custom-select-menu" role="listbox" tabindex="-1">
          <li role="option" data-value="en" aria-selected="false">English</li>
          <li role="option" data-value="ja" aria-selected="true">Japanese</li>
          <li role="option" data-value="ko">Korean</li>
        </ul>
      </div>
    </div>

    <input type="hidden" name="input" value="en">
    <input type="hidden" name="target" value="ja">
  </form>

  <div class="result">
    <div id="result"></div>
    <div id="romanization"></div>
    <div style="display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 15px;">
      <button id="pronounceBtn" class="pronounce-btn" style="display: none;">🔊</button>
      <button type="button" id="saveToStudyBtn" class="save-to-study-btn" style="display: none;">Save to study</button>
    </div>
  </div>

  <div id="studyTableContainer" class="study-table-container">
    <table id="studyTable" class="study-table">
      <thead>
        <tr>
          <th>Word/Sentence</th>
          <th>Definition</th>
        </tr>
      </thead>
      <tbody id="studyTableBody"></tbody>
    </table>
  </div>

  <div id="deleteButtonContainer" class="delete-button-container">
    <button type="button" id="deleteStudyTableBtn" class="delete-study-btn">Delete</button>
  </div>

  <script type="module" src="script.js"></script>
</body>

</html>
